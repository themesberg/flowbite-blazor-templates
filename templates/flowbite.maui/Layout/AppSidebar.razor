@using Microsoft.AspNetCore.Components.Routing

<div id="da-sidebar-outlet" class="h-full">
    <Sidebar class="h-full">

        <SidebarItem
            Href="/dashboard"
            Icon="@(new HomeIcon())">
            Dashboard
        </SidebarItem>

        <SidebarItem
            Href="/crud/products"
            Icon="@(new GridIcon())">
            Products
        </SidebarItem>
        <SidebarItem
            Href="/crud/users"
            Icon="@(new UsersIcon())">
            Users
        </SidebarItem>
        <SidebarItem
            Href="/grid"
            Icon="@(new TableRowIcon())">
            Products Grid
        </SidebarItem>

        <SidebarItem
            Href="/settings"
            Icon="@(new GearIcon())">
            Settings
        </SidebarItem>

        <SidebarItemGroup AdditionalClasses="mt-4 mb-4">
            <SidebarItem
                Href="/layouts/stacked"
                Icon="@(new TableRowIcon())">
                Layout: Stacked
            </SidebarItem>
            <SidebarItem
                Href="/layouts/sidebar"
                Icon="@(new TableRowIcon())">
                Layout: Sidebar
            </SidebarItem>

            <SidebarItem
                Href="/pages/pricing"
                Icon="@(new FileIcon())">
                Pricing
            </SidebarItem>
            <SidebarItem
                Href="/errors/400"
                Icon="@(new FileIcon())">
                Maintenance
            </SidebarItem>
            <SidebarItem
                Href="/errors/404"
                Icon="@(new FileIcon())">
                404 Not Found
            </SidebarItem>
            <SidebarItem
                Href="/errors/500"
                Icon="@(new FileIcon())">
                500 Server Error
            </SidebarItem>

            <SidebarItem
                Href="/playground/stacked"
                Icon="@(new RocketIcon())">
                Playground: Stacked
            </SidebarItem>
            <SidebarItem
                Href="/playground/sidebar"
                Icon="@(new RocketIcon())">
                Playground: Sidebar
            </SidebarItem>

            <SidebarItem
                Href="/icons"
                Icon="@(new ImageIcon())">
                Icons
            </SidebarItem>
        </SidebarItemGroup>

        <SidebarItemGroup AdditionalClasses="mb-4">
            <SidebarItem
                Href="/authentication/sign-in"
                Icon="@(new LockOpenIcon())">
                Sign In
            </SidebarItem>
            <SidebarItem
                Href="/authentication/sign-up"
                Icon="@(new LockOpenIcon())">
                Sign Up
            </SidebarItem>
            <SidebarItem
                Href="/authentication/forgot-password"
                Icon="@(new LockOpenIcon())">
                Forgot Password
            </SidebarItem>
            <SidebarItem
                Href="/authentication/reset-password"
                Icon="@(new LockOpenIcon())">
                Reset Password
            </SidebarItem>
            <SidebarItem
                Href="/authentication/profile-lock"
                Icon="@(new LockOpenIcon())">
                Profile Lock
            </SidebarItem>
        </SidebarItemGroup>

        <SidebarItemGroup>
            <SidebarItem
                Href="https://flowbite-blazor.org/docs/getting-started/quickstart"
                Icon="@(new GridIcon())">
                Quickstart
            </SidebarItem>
            <SidebarItem
                Href="https://github.com/themesberg/flowbite-blazor-templates"
                Icon="@(new GithubIcon())">
                Github Repository
            </SidebarItem>
            <SidebarItem
                Href="https://flowbite-blazor.org"
                Icon="@(new ClipboardArrowIcon())">
                Flowbite Blazor
            </SidebarItem>
            <SidebarItem
                Href="https://github.com/themesberg/flowbite-blazor-templates/issues"
                Icon="@(new QuestionCircleIcon())">
                Support
            </SidebarItem>
        </SidebarItemGroup>
    </Sidebar>
</div>
