@using Microsoft.AspNetCore.Components.Routing

<div id="da-sidebar-outlet" class="h-full">
    <Sidebar class="h-full">

        <SidebarItem
            Href="/dashboard"
            Icon="@(new HomeIcon())">
            Dashboard
        </SidebarItem>

        <SidebarItem
            Href="/components/productdrawer"
            Icon="@(new GridIcon())">
            Product Management
        </SidebarItem>
        <SidebarItem
            Href="/grid"
            Icon="@(new TableRowIcon())">
            Products Grid
        </SidebarItem>

        <SidebarItem
            Href="/crud/products"
            Icon="@(new ListIcon())">
            CRUD
        </SidebarItem>

        <SidebarItem
            Href="/settings"
            Icon="@(new GearIcon())">
            Settings
        </SidebarItem>

        <SidebarItemGroup AdditionalClasses="mt-4 mb-4">
            <SidebarItem
                Href="/layouts/stacked"
                Icon="@(new TableRowIcon())">
                Layouts
            </SidebarItem>

            <SidebarItem
                Href="/pages/pricing"
                Icon="@(new FileIcon())">
                Pages
            </SidebarItem>

            <SidebarItem
                Href="/playground/stacked"
                Icon="@(new RocketIcon())">
                Playground
            </SidebarItem>

            <SidebarItem
                Href="/icons"
                Icon="@(new ImageIcon())">
                Icons
            </SidebarItem>
        </SidebarItemGroup>

        <SidebarItemGroup AdditionalClasses="mb-4">
            <SidebarItem
                Href="/authentication/sign-in"
                Icon="@(new LockOpenIcon())">
                Authentication
            </SidebarItem>
        </SidebarItemGroup>

        <SidebarItemGroup>
            <SidebarItem
                Href="https://flowbite-blazor.org/docs/getting-started/quickstart"
                Icon="@(new GridIcon())">
                Quickstart
            </SidebarItem>
            <SidebarItem
                Href="https://github.com/peakflames/flowbite-blazor-admin-dashboard/"
                Icon="@(new GithubIcon())">
                Github Repository
            </SidebarItem>
            <SidebarItem
                Href="https://flowbite-blazor.org"
                Icon="@(new ClipboardArrowIcon())">
                Flowbite Blazor
            </SidebarItem>
            <SidebarItem
                Href="https://github.com/peakflames/flowbite-blazor-admin-dashboard/issues"
                Icon="@(new QuestionCircleIcon())">
                Support
            </SidebarItem>
        </SidebarItemGroup>
    </Sidebar>
</div>
