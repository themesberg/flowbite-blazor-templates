  "identity": "Flowbite.Templates.Maui.CSharp.10.0",
  "preferNameDirectory": true,
  "primaryOutputs": [
    {
      "path": "Flowbite.Maui.csproj"
    }
  ],
  "shortName": "flowbite-blazor-maui",
  "tags": {
    "language": "C#",
    "type": "project"
  },
  "sourceName": "Flowbite.Maui",
  "sources": [
    {
      "modifiers": [
        {
          "exclude": [ ".template_config/**", "tools/**", "bin/**", "obj/**", "dist/**", "*.pid", "*.log" ]
        }
      ]
    }
  ]
}
