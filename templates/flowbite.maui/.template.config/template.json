{
  "$schema": "https://json.schemastore.org/template",
  "author": "PeakFlames",
  "classifications": [
    "MAUI",
    "Flowbite",
    "Blazor",
    "Hybrid",
    "Desktop",
    "Admin Dashboard",
    "ApexCharts"
  ],
  "name": "Flowbite Blazor MAUI Admin Dashboard",
  "defaultName": "MauiApp",
  "description": "A project template for creating a beautiful, modern desktop admin dashboard with .NET MAUI Blazor Hybrid. Features Flowbite Blazor UI components, Tailwind CSS styling, and ApexCharts integration. Supports Windows and macOS.",
