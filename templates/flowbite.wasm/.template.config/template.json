{
  "$schema": "https://json.schemastore.org/template",
  "author": "PeakFlames",
  "classifications": [
    "Web",
    "Flowbite",
    "Blazor",
    "WebAssembly",
    "Admin Dashboard",
    "ApexCharts"
  ],
  "name": "Flowbite Blazor WASM Admin Dashboard",
  "defaultName": "BlazorApp",
  "description": "A project template for creating a beautiful, modern, and responsive admin dashboard with Blazor WebAssembly. Features Flowbite Blazor UI components, Tailwind CSS styling, ApexCharts integration, and full prerendering support.",
  "groupIdentity": "Flowbite.Wasm",
  "identity": "Flowbite.Templates.Wasm.CSharp.9.0",
  "preferNameDirectory": true,
  "primaryOutputs": [
    {
      "path": "Flowbite.Wasm.csproj"
    }
  ],
  "shortName": "flowbite-blazor-wasm",
  "tags": {
    "language": "C#",
    "type": "project"
  },
  "sourceName": "Flowbite.Wasm",
  "sources": [
    {
      "modifiers": [
        {
          "exclude": [ ".template_config/**", "tools/**", "bin/**", "obj/**", "dist/**", "*.pid", "*.log" ]
        }
      ]
    }
  ]
}
